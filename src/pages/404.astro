---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const quickLinks = [
  { href: "/", label: "Deduplication Studio Tool" },
  { href: "/features", label: "Explore All Features" },
  { href: "/spreadsheet", label: "Excel & Google Sheets Guide" },
  { href: "/compare", label: "Why DeDupe Kit vs Legacy Tools" },
  { href: "/faq", label: "Frequently Asked Questions" },
  { href: "/contact", label: "Contact Support" }
];
---

<Layout
  title="404 — Page Not Found | DeDupe Kit"
  description="The page you were looking for doesn't exist or has moved. Return to the DeDupe Kit text deduplication studio."
>
  <Header />

  <main class="flex-1 flex items-center justify-center py-20 px-4 sm:px-6">
    <div class="max-w-[600px] w-full text-center">
      
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-[#0066cc]/10 text-[#0066cc] dark:text-[#2997ff] text-2xl font-bold mb-6 font-mono">
        404
      </div>

      <h1 class="text-3xl sm:text-4xl font-semibold tracking-[-0.025em] text-[#1d1d1f] dark:text-[#f5f5f7] mb-4">
        Page Not Found
      </h1>

      <p class="text-base sm:text-lg text-[#7a7a7a] dark:text-[#a1a1a6] leading-relaxed mb-8">
        The link you clicked may be broken, or the page may have been moved or removed.
      </p>

      <div class="mb-10">
        <a href="/" class="apple-btn-active inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-[#0066cc] text-white font-medium hover:bg-[#0071e3] transition-all shadow-md">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>Return to Studio Tool</span>
        </a>
      </div>

      <div class="pt-8 border-t border-[#e0e0e0] dark:border-white/10 text-left">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-[#7a7a7a] dark:text-[#a1a1a6] mb-4 text-center">
          Helpful Destinations
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm">
          {quickLinks.map(link => (
            <a href={link.href} class="p-2.5 rounded-xl bg-white dark:bg-[#1c1c1e] border border-[#e0e0e0] dark:border-white/10 text-[#1d1d1f] dark:text-[#f5f5f7] hover:border-[#0066cc] dark:hover:border-[#2997ff] transition-colors flex items-center justify-between group">
              <span>{link.label}</span>
              <span class="text-[#7a7a7a] dark:text-[#a1a1a6] group-hover:text-[#0066cc] dark:group-hover:text-[#2997ff] transition-colors">&rarr;</span>
            </a>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
