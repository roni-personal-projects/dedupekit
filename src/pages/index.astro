---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import DedupeTool from '../components/DedupeTool.astro';
import Features from '../components/Features.astro';
import FeatureComparison from '../components/FeatureComparison.astro';
import SpreadsheetGuide from '../components/SpreadsheetGuide.astro';
import SeoContent from '../components/SeoContent.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout
  title="Remove Duplicates Online — Free Duplicate Line Remover Tool | DeDupe Kit"
  description="Instantly remove duplicates and clean text lists with our free online duplicate line remover tool. 100% private in-browser processing, Excel TSV support, and case matching."
  canonical="https://dedupekit.pages.dev"
  keywords="remove duplicates, remove duplicate lines, duplicate line remover, online duplicate line remover, duplicate line remover tool, deduplicate list, text deduplicator, delete duplicate lines, find duplicate lines, excel remove duplicate lines, google sheets remove duplicates, free duplicate line remover, list deduplication tool"
>
  <Header />

  <main class="flex-1">
    <!-- Interactive Deduplication Studio -->
    <DedupeTool />

    <!-- Feature Grid -->
    <Features />

    <!-- Comparison Against Legacy Tools -->
    <FeatureComparison />

    <!-- Excel & Google Sheets Native Workflow -->
    <SpreadsheetGuide />

    <!-- In-Depth SEO Technical Guide (800 - 1200 words) -->
    <SeoContent />

    <!-- Frequently Asked Questions -->
    <FAQ />
  </main>

  <Footer />
</Layout>
