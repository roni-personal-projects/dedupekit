---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout
  title="Contact Us & Feedback — DeDupe Kit"
  description="Have questions, feature requests, or bug reports? Reach out to the DeDupe Kit team. We love hearing from developers and users."
  canonical="https://dedupekit.pages.dev/contact"
>
  <Header currentPath="/contact" />

  <main class="flex-1">
    <!-- Hero Section -->
    <section class="py-16 sm:py-24 bg-white dark:bg-[#121214] border-b border-[#e0e0e0] dark:border-white/10 transition-colors">
      <div class="max-w-[800px] mx-auto px-4 sm:px-6 text-center">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#0066cc]/10 text-[#0066cc] dark:text-[#2997ff] text-xs font-semibold uppercase tracking-wider mb-4">
          Get In Touch
        </span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-semibold tracking-[-0.03em] text-[#1d1d1f] dark:text-[#f5f5f7] mb-6">
          We’d love to hear from you.
        </h1>
        <p class="text-lg sm:text-xl text-[#7a7a7a] dark:text-[#a1a1a6] max-w-xl mx-auto leading-relaxed">
          Have an idea for a feature, spotted an edge-case bug, or want to share feedback? Drop us a message below.
        </p>
      </div>
    </section>

    <!-- Contact Studio -->
    <section class="py-16 bg-[#f5f5f7] dark:bg-[#18181b] transition-colors">
      <div class="max-w-[700px] mx-auto px-4 sm:px-6">
        
        <div class="bg-white dark:bg-[#1c1c1e] p-8 sm:p-10 rounded-3xl border border-[#e0e0e0] dark:border-white/10 shadow-sm">
          
          <form id="contact-form" class="space-y-6">
            <div>
              <label for="contact-name" class="block text-xs font-semibold uppercase tracking-wider text-[#7a7a7a] dark:text-[#a1a1a6] mb-2">
                Your Name
              </label>
              <input
                type="text"
                id="contact-name"
                required
                class="w-full bg-[#fafafc] dark:bg-[#252528] border border-[#e0e0e0] dark:border-white/10 rounded-xl px-4 py-3 text-sm text-[#1d1d1f] dark:text-[#f5f5f7] focus:outline-none focus:border-[#0066cc] dark:focus:border-[#2997ff] transition-colors"
                placeholder="Jane Doe"
              />
            </div>

            <div>
              <label for="contact-email" class="block text-xs font-semibold uppercase tracking-wider text-[#7a7a7a] dark:text-[#a1a1a6] mb-2">
                Email Address
              </label>
              <input
                type="email"
                id="contact-email"
                required
                class="w-full bg-[#fafafc] dark:bg-[#252528] border border-[#e0e0e0] dark:border-white/10 rounded-xl px-4 py-3 text-sm text-[#1d1d1f] dark:text-[#f5f5f7] focus:outline-none focus:border-[#0066cc] dark:focus:border-[#2997ff] transition-colors"
                placeholder="jane@company.com"
              />
            </div>

            <div>
              <label for="contact-subject" class="block text-xs font-semibold uppercase tracking-wider text-[#7a7a7a] dark:text-[#a1a1a6] mb-2">
                Topic
              </label>
              <select
                id="contact-subject"
                class="w-full bg-[#fafafc] dark:bg-[#252528] border border-[#e0e0e0] dark:border-white/10 rounded-xl px-4 py-3 text-sm text-[#1d1d1f] dark:text-[#f5f5f7] focus:outline-none focus:border-[#0066cc] dark:focus:border-[#2997ff] transition-colors cursor-pointer"
              >
                <option value="feedback">General Feedback</option>
                <option value="feature">Feature Request</option>
                <option value="bug">Bug Report / Edge Case</option>
                <option value="other">Other Inquiry</option>
              </select>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-semibold uppercase tracking-wider text-[#7a7a7a] dark:text-[#a1a1a6] mb-2">
                Message
              </label>
              <textarea
                id="contact-message"
                rows="5"
                required
                class="w-full bg-[#fafafc] dark:bg-[#252528] border border-[#e0e0e0] dark:border-white/10 rounded-xl p-4 text-sm text-[#1d1d1f] dark:text-[#f5f5f7] focus:outline-none focus:border-[#0066cc] dark:focus:border-[#2997ff] transition-colors resize-none font-sans"
                placeholder="Tell us what's on your mind..."
              ></textarea>
            </div>

            <div>
              <button
                type="submit"
                id="submit-btn"
                class="apple-btn-active w-full py-3.5 px-6 rounded-full bg-[#0066cc] text-white text-sm font-semibold hover:bg-[#0071e3] transition-all shadow-md cursor-pointer flex items-center justify-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
                <span>Send Message</span>
              </button>
            </div>
          </form>

          <!-- Success Alert -->
          <div id="contact-success" class="hidden mt-6 p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-center text-sm text-emerald-800 dark:text-emerald-300">
            <svg class="w-6 h-6 mx-auto mb-2 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <p class="font-semibold">Message Received!</p>
            <p class="text-xs mt-1 text-emerald-700 dark:text-emerald-400">Thank you for your feedback. We appreciate you helping us make DeDupe Kit better.</p>
          </div>

        </div>

        <!-- Quick Help Note -->
        <div class="mt-8 text-center text-xs text-[#7a7a7a] dark:text-[#a1a1a6]">
          Looking for immediate answers? Check our <a href="/faq" class="text-[#0066cc] dark:text-[#2997ff] hover:underline font-medium">FAQ & Help Center</a>.
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline>
  const form = document.getElementById('contact-form');
  const successBox = document.getElementById('contact-success');
  const submitBtn = document.getElementById('submit-btn');

  if (form && successBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.innerHTML = 'Sending...';

      setTimeout(() => {
        form.reset();
        submitBtn.disabled = false;
        submitBtn.innerHTML = 'Send Message';
        successBox.classList.remove('hidden');
      }, 600);
    });
  }
</script>
