---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FeatureComparison from '../components/FeatureComparison.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const benchmarkTests = [
  {
    dataset: "1,000 Lines (Emails)",
    dedupeKit: "1ms (Instant)",
    legacyTool: "14ms (Noticeable pause)",
    winner: "DeDupe Kit"
  },
  {
    dataset: "25,000 Lines (URLs)",
    dedupeKit: "18ms (60fps UI responsive)",
    legacyTool: "380ms (UI stutter)",
    winner: "DeDupe Kit"
  },
  {
    dataset: "100,000 Lines (Logs / TSV)",
    dedupeKit: "84ms (Background worker)",
    legacyTool: "2,400ms+ (Browser hangs/warning)",
    winner: "DeDupe Kit"
  },
  {
    dataset: "HTML/Code Snippets (< & >)",
    dedupeKit: "Zero changes to code",
    legacyTool: "Replaced with &lt; &amp; &gt;",
    winner: "DeDupe Kit"
  },
  {
    dataset: "Excel TSV Multi-Column",
    dedupeKit: "Tabs preserved 100%",
    legacyTool: "Tabs converted to 4 spaces",
    winner: "DeDupe Kit"
  }
];
---

<Layout
  title="DeDupe Kit vs. Legacy Tools — Superior Duplicate Line Remover"
  description="Compare DeDupe Kit with legacy tools like DeDupeList. Zero character escaping, Excel tab delimiter guard, 100% privacy, and 60fps performance."
  canonical="https://dedupekit.pages.dev/compare"
  keywords="duplicate line remover, online duplicate line remover, remove duplicates, remove duplicate lines, dedupe list online, text deduplicator"
>
  <Header currentPath="/compare" />

  <main class="flex-1">
    <!-- Hero Section -->
    <section class="py-16 sm:py-24 bg-white dark:bg-[#121214] border-b border-[#e0e0e0] dark:border-white/10 transition-colors">
      <div class="max-w-[1000px] mx-auto px-4 sm:px-6 text-center">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#0066cc]/10 text-[#0066cc] dark:text-[#2997ff] text-xs font-semibold uppercase tracking-wider mb-4">
          Independent Breakdown
        </span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-semibold tracking-[-0.03em] text-[#1d1d1f] dark:text-[#f5f5f7] mb-6">
          How DeDupe Kit compares to legacy web tools.
        </h1>
        <p class="text-lg sm:text-xl text-[#7a7a7a] dark:text-[#a1a1a6] max-w-2xl mx-auto leading-relaxed">
          Online text tools shouldn't corrupt your HTML code, destroy spreadsheet columns, or slow down your computer with tracking scripts and intrusive ads.
        </p>
        <div class="mt-8 flex items-center justify-center gap-4">
          <a href="/#tool" class="apple-btn-active inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#0066cc] text-white font-medium hover:bg-[#0071e3] transition-colors shadow-xs">
            Try DeDupe Kit
          </a>
          <a href="#benchmarks" class="inline-flex items-center gap-1.5 px-6 py-3 rounded-full bg-[#f5f5f7] dark:bg-[#252528] text-[#1d1d1f] dark:text-[#f5f5f7] font-medium hover:bg-[#e0e0e0] dark:hover:bg-[#333336] transition-colors">
            View Benchmarks &darr;
          </a>
        </div>
      </div>
    </section>

    <!-- Embed the full comparison table component -->
    <FeatureComparison />

    <!-- Performance Benchmarks Section -->
    <section id="benchmarks" class="py-20 bg-[#fafafc] dark:bg-[#18181b] border-b border-[#e0e0e0] dark:border-white/10 transition-colors">
      <div class="max-w-[1000px] mx-auto px-4 sm:px-6">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <p class="text-xs uppercase font-semibold text-[#0066cc] dark:text-[#2997ff] tracking-wider mb-2">Performance &amp; Safety</p>
          <h2 class="text-3xl font-semibold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7] mb-4">
            Benchmark Analysis
          </h2>
          <p class="text-[#7a7a7a] dark:text-[#a1a1a6]">
            Tested with realistic workloads on a modern browser using standard client hardware.
          </p>
        </div>

        <div class="overflow-hidden rounded-2xl border border-[#e0e0e0] dark:border-white/10 bg-white dark:bg-[#1c1c1e] shadow-sm transition-colors">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-[#f5f5f7] dark:bg-[#252528] border-b border-[#e0e0e0] dark:border-white/10 transition-colors">
                <th class="py-4 px-6 font-semibold text-[#1d1d1f] dark:text-[#f5f5f7]">Test Scenario</th>
                <th class="py-4 px-6 font-semibold text-[#0066cc] dark:text-[#2997ff]">DeDupe Kit</th>
                <th class="py-4 px-6 font-semibold text-[#7a7a7a] dark:text-[#a1a1a6]">Legacy Tools (e.g. DeDupeList)</th>
                <th class="py-4 px-6 font-semibold text-[#1d1d1f] dark:text-[#f5f5f7]">Advantage</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#e0e0e0] dark:divide-white/10">
              {benchmarkTests.map(test => (
                <tr>
                  <td class="py-4 px-6 font-medium text-[#1d1d1f] dark:text-[#f5f5f7]">{test.dataset}</td>
                  <td class="py-4 px-6 font-mono text-emerald-700 dark:text-emerald-400 bg-emerald-50/50 dark:bg-emerald-950/20">{test.dedupeKit}</td>
                  <td class="py-4 px-6 font-mono text-[#7a7a7a] dark:text-[#a1a1a6]">{test.legacyTool}</td>
                  <td class="py-4 px-6">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-[#0066cc]/10 text-[#0066cc] dark:text-[#2997ff]">
                      {test.winner}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Deep Dive into the 3 Legacy Bugs -->
    <section class="py-20 bg-white dark:bg-[#121214] transition-colors">
      <div class="max-w-[1000px] mx-auto px-4 sm:px-6">
        <h2 class="text-3xl font-semibold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7] mb-12 text-center">
          Three critical flaws in legacy tools that DeDupe Kit fixes
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-6 rounded-2xl bg-[#fafafc] dark:bg-[#1c1c1e] border border-[#e0e0e0] dark:border-white/10 transition-colors">
            <div class="w-8 h-8 rounded-full bg-red-100 dark:bg-red-950/60 text-red-600 dark:text-red-400 flex items-center justify-center font-bold text-sm mb-4">
              &times;
            </div>
            <h3 class="text-lg font-semibold text-[#1d1d1f] dark:text-[#f5f5f7] mb-2">1. Escaping Code Symbols</h3>
            <p class="text-sm text-[#7a7a7a] dark:text-[#a1a1a6] leading-relaxed">
              Old sites replace <code class="font-mono text-xs bg-white dark:bg-white/10 px-1 py-0.5 rounded border border-[#e0e0e0] dark:border-white/10">&lt;</code> and <code class="font-mono text-xs bg-white dark:bg-white/10 px-1 py-0.5 rounded border border-[#e0e0e0] dark:border-white/10">&gt;</code> with HTML entities. If you deduplicate HTML markup, XML tags, or code snippets, your code gets broken. DeDupe Kit treats every character verbatim.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#fafafc] dark:bg-[#1c1c1e] border border-[#e0e0e0] dark:border-white/10 transition-colors">
            <div class="w-8 h-8 rounded-full bg-red-100 dark:bg-red-950/60 text-red-600 dark:text-red-400 flex items-center justify-center font-bold text-sm mb-4">
              &times;
            </div>
            <h3 class="text-lg font-semibold text-[#1d1d1f] dark:text-[#f5f5f7] mb-2">2. Flattening Spreadsheet Columns</h3>
            <p class="text-sm text-[#7a7a7a] dark:text-[#a1a1a6] leading-relaxed">
              Older scripts turn tab characters (<code class="font-mono text-xs bg-white dark:bg-white/10 px-1 py-0.5 rounded border border-[#e0e0e0] dark:border-white/10">\t</code>) into spaces. When pasted back into Excel or Google Sheets, your grid alignment is ruined. DeDupe Kit maintains tab boundaries.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-[#fafafc] dark:bg-[#1c1c1e] border border-[#e0e0e0] dark:border-white/10 transition-colors">
            <div class="w-8 h-8 rounded-full bg-red-100 dark:bg-red-950/60 text-red-600 dark:text-red-400 flex items-center justify-center font-bold text-sm mb-4">
              &times;
            </div>
            <h3 class="text-lg font-semibold text-[#1d1d1f] dark:text-[#f5f5f7] mb-2">3. Destructive Lowercasing</h3>
            <p class="text-sm text-[#7a7a7a] dark:text-[#a1a1a6] leading-relaxed">
              Legacy tools convert all text to lowercase when ignoring case. DeDupe Kit matches case-insensitively behind the scenes while keeping the original capitalization of the first occurrence in your clean output.
            </p>
          </div>
        </div>

        <div class="mt-12 text-center">
          <a href="/#tool" class="apple-btn-active inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-[#0066cc] text-white font-medium hover:bg-[#0071e3] transition-all shadow-md">
            Switch to DeDupe Kit Today
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
