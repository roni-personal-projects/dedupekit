---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout
  title="500 — Application Error | DeDupe Kit"
  description="An unexpected error occurred while loading the utility. Reload the page to reset local browser memory."
>
  <Header />

  <main class="flex-1 flex items-center justify-center py-20 px-4 sm:px-6">
    <div class="max-w-[560px] w-full text-center">
      
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 text-2xl font-bold mb-6 font-mono">
        500
      </div>

      <h1 class="text-3xl sm:text-4xl font-semibold tracking-[-0.025em] text-[#1d1d1f] dark:text-[#f5f5f7] mb-4">
        Unexpected Hitch
      </h1>

      <p class="text-base sm:text-lg text-[#7a7a7a] dark:text-[#a1a1a6] leading-relaxed mb-6">
        Something unexpected interrupted the client-side session. Because DeDupe Kit runs entirely inside your browser RAM, a quick page reload clears and re-initializes all local workers.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <button
          type="button"
          onclick="window.location.reload()"
          class="apple-btn-active w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3 rounded-full bg-[#0066cc] text-white font-medium hover:bg-[#0071e3] transition-all shadow-md cursor-pointer"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="23 4 23 10 17 10"></polyline>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
          <span>Reload Application</span>
        </button>

        <a
          href="/"
          class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3 rounded-full bg-white dark:bg-[#1c1c1e] border border-[#e0e0e0] dark:border-white/10 text-[#1d1d1f] dark:text-[#f5f5f7] font-medium hover:bg-[#fafafc] dark:hover:bg-[#252528] transition-colors"
        >
          Return Home
        </a>
      </div>

      <div class="mt-8 text-xs text-[#7a7a7a] dark:text-[#a1a1a6]">
        Still experiencing issues? You can report an edge case on our <a href="/contact" class="text-[#0066cc] dark:text-[#2997ff] hover:underline font-medium">Contact & Support page</a>.
      </div>

    </div>
  </main>

  <Footer />
</Layout>
