---
// Footer.astro adhering to DESIGN.md parchment specifications and full dark mode
---

<footer class="bg-[#f5f5f7] dark:bg-[#0d0d0f] text-[#333333] dark:text-[#a1a1a6] pt-16 pb-12 border-t border-[#e0e0e0] dark:border-white/10 transition-colors">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
    
    <!-- Privacy Declaration Banner -->
    <div class="mb-12 p-6 rounded-2xl bg-white dark:bg-[#18181b] border border-[#e0e0e0] dark:border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-colors">
      <div class="flex items-start sm:items-center gap-3.5">
        <div class="w-10 h-10 rounded-full bg-emerald-100 dark:bg-emerald-950/60 flex items-center justify-center shrink-0 text-emerald-700 dark:text-emerald-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <h4 class="font-semibold text-sm text-[#1d1d1f] dark:text-[#f5f5f7]">100% Client-Side Privacy Guarantee</h4>
          <p class="text-xs text-[#7a7a7a] dark:text-[#a1a1a6] mt-0.5">
            Your lists and data never leave your browser. Processing runs in local browser memory via Web Workers. No tracking, no logs, no servers.
          </p>
        </div>
      </div>
      <div class="shrink-0 flex items-center gap-3">
        <a href="/privacy" class="text-xs text-[#0066cc] dark:text-[#2997ff] hover:underline font-medium">Read Privacy Policy &rarr;</a>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#f0f0f0] dark:bg-white/10 text-xs font-medium text-[#1d1d1f] dark:text-[#f5f5f7]">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          Zero Server Calls
        </span>
      </div>
    </div>

    <!-- Structured Nav Columns (DESIGN.md dense link columns) -->
    <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 gap-8 pb-12 border-b border-[#e0e0e0] dark:border-white/10 text-xs">
      
      <!-- Col 1 -->
      <div>
        <h5 class="font-semibold text-[#1d1d1f] dark:text-[#f5f5f7] text-[13px] mb-3">Tool & Studio</h5>
        <ul class="space-y-2 text-[#7a7a7a] dark:text-[#a1a1a6]">
          <li><a href="/" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Deduplication Studio</a></li>
          <li><a href="/features#case-matching" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Case Matching</a></li>
          <li><a href="/features#sorting-suite" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Sort Alphabetically</a></li>
          <li><a href="/features#audit-mode" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Audit Duplicates Only</a></li>
          <li><a href="/features#frequency" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Frequency Counter</a></li>
        </ul>
      </div>

      <!-- Col 2 -->
      <div>
        <h5 class="font-semibold text-[#1d1d1f] dark:text-[#f5f5f7] text-[13px] mb-3">Spreadsheets & Guides</h5>
        <ul class="space-y-2 text-[#7a7a7a] dark:text-[#a1a1a6]">
          <li><a href="/#guide" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Deduplication Guide</a></li>
          <li><a href="/spreadsheet" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Excel & Sheets Guide</a></li>
          <li><a href="/spreadsheet#tab-preservation" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Tab Delimiter Guard</a></li>
          <li><a href="/spreadsheet#column-dedupe" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Column-Specific Deduplication</a></li>
          <li><a href="/spreadsheet#csv-vs-tsv" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">CSV vs TSV Formats</a></li>
          <li><a href="/spreadsheet#workflow" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">3-Step Copy/Paste Tutorial</a></li>
        </ul>
      </div>

      <!-- Col 3 -->
      <div>
        <h5 class="font-semibold text-[#1d1d1f] dark:text-[#f5f5f7] text-[13px] mb-3">Comparison & Tech</h5>
        <ul class="space-y-2 text-[#7a7a7a] dark:text-[#a1a1a6]">
          <li><a href="/compare" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">DeDupe Kit vs DeDupeList</a></li>
          <li><a href="/compare#benchmarks" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Performance Benchmarks</a></li>
          <li><a href="/features" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Web Worker Pipeline</a></li>
          <li><a href="/about" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">About DeDupe Kit</a></li>
          <li><a href="/contact" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Contact & Feedback</a></li>
        </ul>
      </div>

      <!-- Col 4 -->
      <div>
        <h5 class="font-semibold text-[#1d1d1f] dark:text-[#f5f5f7] text-[13px] mb-3">Legal & Support</h5>
        <ul class="space-y-2 text-[#7a7a7a] dark:text-[#a1a1a6]">
          <li><a href="/faq" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Help Center & FAQ</a></li>
          <li><a href="/privacy" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Terms & Conditions</a></li>
          <li><a href="/contact" class="hover:text-[#0066cc] dark:hover:text-[#2997ff] transition-colors">Report Bug</a></li>
          <li><span class="text-[#86868b] dark:text-[#636366]">dedupekit.pages.dev</span></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Legal Row (DESIGN.md micro-legal / fine-print) -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[12px] text-[#7a7a7a] dark:text-[#a1a1a6]">
      <div class="flex items-center gap-2.5">
        <img src="/favicon.svg" alt="DeDupe Kit" class="w-5 h-5 rounded-md" />
        <span>© {new Date().getFullYear()} DeDupe Kit (<a href="https://dedupekit.pages.dev" class="text-[#0066cc] dark:text-[#2997ff] hover:underline">dedupekit.pages.dev</a>). All rights reserved.</span>
      </div>
      <div class="flex items-center gap-6">
        <a href="/about" class="hover:underline">About</a>
        <a href="/privacy" class="hover:underline">Privacy</a>
        <a href="/terms" class="hover:underline">Terms</a>
        <a href="/contact" class="hover:underline">Contact</a>
      </div>
    </div>

  </div>
</footer>
