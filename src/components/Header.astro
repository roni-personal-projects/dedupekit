---
// Header.astro — Modern, polished, spacious Apple-inspired navigation bar
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { href: "/", label: "Studio Tool" },
  { href: "/features", label: "Features" },
  { href: "/spreadsheet", label: "Excel & Sheets" },
  { href: "/compare", label: "Why DeDupeKit" },
  { href: "/faq", label: "FAQ" }
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-2xl bg-[#000000]/85 border-b border-white/[0.08] shadow-[0_4px_30px_rgba(0,0,0,0.15)] transition-all">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 h-[64px] flex items-center justify-between">
    
    <!-- Brand Identity -->
    <a href="/" class="flex items-center gap-3 group select-none">
      <img
        src="/favicon.svg"
        alt="DeDupe Kit Logo"
        class="w-8 h-8 rounded-xl shadow-[0_2px_12px_rgba(0,102,204,0.45)] group-hover:scale-105 transition-transform duration-200"
      />
      <div class="flex items-center gap-2">
        <span class="font-semibold text-white tracking-[-0.025em] text-[17px] sm:text-[18px]">
          DeDupe<span class="text-[#2997ff]">Kit</span>
        </span>
        <span class="hidden lg:inline-flex items-center px-2 py-0.5 rounded-full bg-white/[0.08] text-[10px] font-medium text-[#a1a1a6] border border-white/[0.08]">
          v1.0
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links (Pill Tabs) -->
    <nav class="hidden md:flex items-center gap-1.5 bg-white/[0.06] p-1 rounded-full border border-white/[0.08]">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`text-[13.5px] font-medium px-4 py-1.5 rounded-full transition-all duration-150 ${
              isActive
                ? 'bg-white/15 text-white shadow-xs'
                : 'text-[#a1a1a6] hover:text-white hover:bg-white/[0.08]'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Controls & CTA -->
    <div class="flex items-center gap-3">
      
      <!-- Privacy Badge -->
      <a
        href="/privacy"
        class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/[0.06] hover:bg-white/[0.1] text-xs font-medium text-[#cccccc] border border-white/[0.08] transition-colors"
        title="100% Private: All processing happens in local browser RAM"
      >
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>100% Client-Side</span>
      </a>

      <!-- Quick Action CTA -->
      <a
        href="/#tool"
        class="apple-btn-active hidden sm:inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-[#0066cc] hover:bg-[#0071e3] text-white text-[13px] font-medium shadow-[0_2px_10px_rgba(0,102,204,0.35)] transition-all"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <span>Open Tool</span>
      </a>

      <!-- Theme Mode Toggle -->
      <button
        type="button"
        id="theme-toggle-btn"
        class="flex items-center justify-center w-9 h-9 rounded-full bg-white/[0.08] hover:bg-white/[0.14] text-[#cccccc] hover:text-white border border-white/[0.08] transition-colors cursor-pointer"
        aria-label="Toggle dark mode"
        title="Toggle Theme (Light / Dark / System)"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="theme-sun-icon" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="theme-moon-icon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="md:hidden flex items-center justify-center w-9 h-9 rounded-xl bg-white/[0.08] text-[#cccccc] hover:text-white hover:bg-white/[0.12] transition-colors cursor-pointer"
        aria-label="Toggle Navigation"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Dropdown Tray -->
  <div id="mobile-menu" class="hidden md:hidden bg-[#0d0d0e]/95 backdrop-blur-2xl border-b border-white/[0.08] px-5 py-4 text-sm flex flex-col gap-2">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <a
          href={link.href}
          class={`py-2 px-3 rounded-lg font-medium transition-colors ${
            isActive
              ? 'bg-white/10 text-white'
              : 'text-[#a1a1a6] hover:text-white hover:bg-white/[0.05]'
          }`}
        >
          {link.label}
        </a>
      );
    })}
    <div class="pt-2 mt-2 border-t border-white/[0.08] flex items-center justify-between text-xs">
      <button type="button" id="mobile-theme-btn" class="text-[#cccccc] hover:text-white flex items-center gap-1.5 py-1">
        <span id="mobile-theme-label">Theme: Auto</span>
      </button>
      <a href="/#tool" class="px-3.5 py-1.5 rounded-full bg-[#0066cc] text-white text-xs font-semibold">
        Open Tool
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Dark Mode Toggle Logic
  const themeToggleBtn = document.getElementById('theme-toggle-btn');
  const mobileThemeBtn = document.getElementById('mobile-theme-btn');
  const mobileThemeLabel = document.getElementById('mobile-theme-label');
  const sunIcon = document.getElementById('theme-sun-icon');
  const moonIcon = document.getElementById('theme-moon-icon');

  function updateThemeUI() {
    const isDark = document.documentElement.classList.contains('dark');
    const stored = localStorage.getItem('theme');
    
    if (isDark) {
      sunIcon.classList.remove('hidden');
      moonIcon.classList.add('hidden');
    } else {
      sunIcon.classList.add('hidden');
      moonIcon.classList.remove('hidden');
    }

    if (mobileThemeLabel) {
      mobileThemeLabel.textContent = `Theme: ${stored === 'dark' ? 'Dark' : stored === 'light' ? 'Light' : 'Auto'}`;
    }
  }

  function toggleTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
    updateThemeUI();
  }

  if (themeToggleBtn) {
    themeToggleBtn.addEventListener('click', toggleTheme);
  }
  if (mobileThemeBtn) {
    mobileThemeBtn.addEventListener('click', toggleTheme);
  }

  // Initial UI sync
  updateThemeUI();
</script>
